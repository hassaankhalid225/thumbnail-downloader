# Copy to frontend/.env.local.

# Where the FastAPI backend lives. Server-side only — the browser never sees it,
# because every request goes through the route handlers under app/api/.
API_URL=http://127.0.0.1:8000

# Used for canonical URLs, the sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Analyzer master switch.
#
# false — pure thumbnail downloader. No analysis request is fired, no scores or
#         AI verdict render, /compare and /channel show a "switched off" notice,
#         the upload-your-own-image path is hidden, and every piece of copy and
#         metadata drops its analysis claims so the page never promises something
#         it isn't doing.
#
# true  — the full product: eight measured sub-scores, palette, text placement,
#         mobile legibility, safe zones and the Claude verdict.
#
# Switching this does not touch any code. The analysis stack is always present.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYSIS=false
