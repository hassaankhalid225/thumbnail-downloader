# --- python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/
dist/
build/
.python-version

# --- node / next ---
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.vercel/
.eslintcache
.npm/
.pnp.*
.yarn/*
!.yarn/releases

# --- secrets ---
# .env.example is committed; the real ones never are.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# --- fetched model weights ---
# Regenerated by `python backend/scripts/fetch_models.py`, and baked into the Docker
# image at build time. ~7 MB of binaries that don't belong in git history.
backend/models/*.onnx
backend/models/*.caffemodel
backend/models/*.xml
backend/models/*.prototxt

# --- logs / runtime junk ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pip-log.txt
tmp/
temp/
.cache/

# --- os / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
