# Copy to backend/.env and fill in. Every value here has a working default except the
# API key — ThumbIQ runs without it and degrades the AI verdict only.

# --- AI ---------------------------------------------------------------------
# Without this, the deterministic analysis still runs and the UI shows an amber banner.
ANTHROPIC_API_KEY=sk-ant-...
AI_ENABLED=true
AI_MODEL=claude-opus-4-8
AI_EFFORT=high
AI_MAX_TOKENS=8000
AI_TIMEOUT=120

# --- CORS -------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,https://thumbiq.app

# --- rate limits (per client IP) --------------------------------------------
# The AI limit is separate and hourly: the deterministic analysis is free to run and
# stays generous, while the Claude call costs real money.
RATE_LIMIT_THUMBNAILS_PER_MIN=30
RATE_LIMIT_ANALYZE_PER_MIN=10
RATE_LIMIT_AI_PER_HOUR=40
RATE_LIMIT_BATCH_PER_HOUR=6
RATE_LIMIT_DOWNLOAD_PER_MIN=60

# --- caching (in memory only — nothing is written to disk) ------------------
CACHE_TTL_SECONDS=3600
CACHE_MAX_IMAGES=128
CACHE_MAX_RENDITIONS=1024
CACHE_MAX_ANALYSES=256

# --- fetching ---------------------------------------------------------------
MAX_IMAGE_BYTES=20971520
CONNECT_TIMEOUT=15
TOTAL_TIMEOUT=30

# Never set this to true outside a test run — it disables the SSRF guard.
ALLOW_PRIVATE_HOSTS=false

# --- analysis ---------------------------------------------------------------
ANALYSIS_CONCURRENCY=4
BATCH_CONCURRENCY=4
BATCH_MAX_ITEMS=24
OCR_MIN_CONFIDENCE=55

# Only needed when tesseract isn't on PATH (typical on Windows).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

DEBUG=false
